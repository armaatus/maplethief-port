#!/usr/bin/env bash
# Long local runs of the libFuzzer targets of tests/fuzz/ (#322, ADR 0158).
#
# Usage: scripts/fuzz TARGET...|all [--hours H] [--arch amd64|arm64] [--build-only]
#        scripts/fuzz --list
# (the options are described in usage() below, printed by scripts/fuzz --help)
#
# Builds the linux-fuzz preset's targets and runs each named target until it has used H hours
# of CPU time (default 1), all of them at once, one process each. libFuzzer needs clang's
# runtime, which Apple's clang does not ship: on a Mac this runs itself in the pinned Linux
# container of tools/containers/linux/ (scripts/test-linux's image, arm64 by default: native on
# Apple silicon), with the working tree mounted. On Linux it runs here, with clang.
#
# Outputs, all below build/:
#   build/fuzz/TARGET/corpus/      the corpus, kept and grown from run to run
#   build/fuzz/TARGET/runs.jsonl   one line per run: CPU and wall seconds, inputs, exit code
#   build/fuzz/TARGET/run-*.log    libFuzzer's output
#   build/fuzz/TARGET/crash-*      a finding (also leak-, timeout-, oom-): see tests/fuzz/README.md
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

usage() {
    cat >&2 <<'EOF'
Usage: scripts/fuzz TARGET...|all [--hours H] [--arch amd64|arm64] [--build-only]
       scripts/fuzz --list

  TARGET        a target of tests/fuzz/ (scripts/fuzz --list), or all of them
  --hours H     CPU hours per target (default 1; 0.05 is three minutes)
  --arch ARCH   the container's architecture on a Mac: arm64 (default, native on Apple
                silicon) or amd64 (what CI runs, under Rosetta)
  --build-only  build the targets and their seeds, run nothing
  --list        print the targets
EOF
    exit "${1:-2}"
}

hours=1
arch=arm64
build_only=0
targets=()
in_container="${MAPLETHIEF_FUZZ_IN_CONTAINER:-0}"
while [ "$#" -gt 0 ]; do
    case "$1" in
        --hours)
            [ "$#" -ge 2 ] || usage
            hours="$2"
            shift 2
            ;;
        --arch)
            [ "$#" -ge 2 ] || usage
            arch="$2"
            shift 2
            ;;
        --build-only) build_only=1; shift ;;
        --list) exec python3 -I -B tests/fuzz/fuzz_run.py list ;;
        -h | --help) usage 0 ;;
        -*) echo "scripts/fuzz: unknown option: $1" >&2; usage ;;
        *) targets+=("$1"); shift ;;
    esac
done
[ "${#targets[@]}" -gt 0 ] || [ "$build_only" -eq 1 ] || usage
case "$arch" in
    amd64 | arm64) ;;
    *) echo "scripts/fuzz: --arch must be amd64 or arm64, not $arch" >&2; exit 2 ;;
esac
known="$(python3 -I -B tests/fuzz/fuzz_run.py list)"
if [ "${#targets[@]}" -eq 1 ] && [ "${targets[0]}" = all ]; then
    # shellcheck disable=SC2206 # one target per line, no spaces
    targets=($known)
fi
for t in ${targets[@]+"${targets[@]}"}; do
    grep -qx "$t" <<<"$known" || { echo "scripts/fuzz: no target $t (scripts/fuzz --list)" >&2; exit 2; }
done

# --- On a Mac: the same command in the Linux container --------------------------------------
if [ "$(uname -s)" != Linux ]; then
    command -v docker >/dev/null 2>&1 || {
        echo "scripts/fuzz: docker not found (on a Mac: OrbStack or Docker Desktop)" >&2
        exit 2
    }
    image="$(scripts/test-linux --image-name --arch "$arch")"
    mkdir -p build/_downloads
    downloads="$(cd "${MAPLETHIEF_DOWNLOAD_DIR:-build/_downloads}" && pwd -P)"
    args=(--hours "$hours")
    [ "$build_only" -eq 0 ] || args+=(--build-only)
    echo "== scripts/fuzz in $image: ${targets[*]+"${targets[*]}"}" >&2
    # The working tree at its own path (so that the build's paths are the host's) with its git
    # directory (a worktree's is elsewhere) read-only, the shared download cache, and a scratch
    # tmpfs for the targets that write files.
    git_dir="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
    exec docker run --rm --platform "linux/$arch" \
        -v "$REPO:$REPO" -w "$REPO" -v "$git_dir:$git_dir:ro" \
        -v "$downloads:/cache/downloads" \
        --tmpfs /fuzztmp:size=1g -e TMPDIR=/fuzztmp \
        -e MAPLETHIEF_FUZZ_IN_CONTAINER=1 -e MAPLETHIEF_FUZZ_BUILD="build/linux-fuzz-$arch" \
        -e MAPLETHIEF_DOWNLOAD_DIR=/cache/downloads \
        "$image" scripts/fuzz ${targets[@]+"${targets[@]}"} "${args[@]}"
fi

# --- Here: build, then run every target at once ---------------------------------------------
build="${MAPLETHIEF_FUZZ_BUILD:-build/linux-fuzz}"
configure=(cmake --preset linux-fuzz -B "$build")
if [ -n "${MAPLETHIEF_DOWNLOAD_DIR:-}" ]; then
    configure+=("-DMAPLETHIEF_DOWNLOAD_DIR=$MAPLETHIEF_DOWNLOAD_DIR")
fi
if [ "$in_container" = 1 ]; then
    # The working tree belongs to the host's user; let git (CMake's version lookup) read it.
    git config --global --add safe.directory '*'
fi
"${configure[@]}" >/dev/null
cmake --build "$build" --target maplethief_fuzz
[ "$build_only" -eq 0 ] || exit 0

pids=()
for t in "${targets[@]}"; do
    out="build/fuzz/$t"
    mkdir -p "$out"
    python3 -I -B tests/fuzz/fuzz_run.py run "$t" --binary "$build/tests/fuzz/fuzz_$t" \
        --seeds "$build/tests/fuzz/seeds/$t" --corpus "$out/corpus" --out "$out" \
        --cpu-hours "$hours" >"$out/fuzz_run.out" 2>&1 &
    pids+=($!)
    echo "== fuzz_$t: $hours CPU h, output in $out/" >&2
done
status=0
for i in "${!pids[@]}"; do
    if wait "${pids[$i]}"; then
        tail -n 1 "build/fuzz/${targets[$i]}/fuzz_run.out"
    else
        status=1
        echo "== fuzz_${targets[$i]}: FINDING or failure, see build/fuzz/${targets[$i]}/" >&2
        tail -n 5 "build/fuzz/${targets[$i]}/fuzz_run.out" >&2
    fi
done
exit "$status"
