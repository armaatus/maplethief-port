#!/usr/bin/env bash
# Run the repo's formatters and linters (ADR 0002) over git-tracked files.
# Exits non-zero on any finding. Tools run through uvx at pinned versions, so no global
# install is needed and every machine gets the same result. Bump a version in its own commit.
#
# Usage: scripts/lint [--fix] [--no-tidy]
#   --fix      applies ruff and clang-format fixes in place.
#   --no-tidy  skips clang-tidy, the slow step (a few minutes), for a quick pass; CI never skips it.

set -euo pipefail

RUFF_VERSION=0.17.2
CLANG_FORMAT_VERSION=23.1.3
SHELLCHECK_PY_VERSION=0.11.0.1
CLANG_TIDY_VERSION=23.1.3

fix=0
tidy=1
for arg in "$@"; do
    case "$arg" in
        --fix) fix=1 ;;
        --no-tidy) tidy=0 ;;
        *) echo "usage: scripts/lint [--fix] [--no-tidy]" >&2; exit 2 ;;
    esac
done

cd "$(git rev-parse --show-toplevel)"

if ! command -v uvx >/dev/null 2>&1; then
    echo "scripts/lint: uvx not found. Install uv: https://docs.astral.sh/uv/" >&2
    exit 2
fi

python=python3
command -v "$python" >/dev/null 2>&1 || python=python

status=0
run() {
    echo "+ $*"
    "$@" || status=1
}

# Collect git-tracked files matching the given pathspecs into the array `files`
# (bash 3.2 compatible: no mapfile).
tracked() {
    files=()
    while IFS= read -r -d '' f; do
        files+=("$f")
    done < <(git ls-files -z -- "$@")
}

# Python
ruff=(uvx "ruff@${RUFF_VERSION}")
if [ "$fix" -eq 1 ]; then
    run "${ruff[@]}" check --fix .
    run "${ruff[@]}" format .
else
    run "${ruff[@]}" check .
    run "${ruff[@]}" format --check .
fi

# C, C++, Objective-C(++)
clang_format=(uvx "clang-format@${CLANG_FORMAT_VERSION}")
# Fails if .clang-format doesn't parse, even when there is nothing to format yet.
echo "+ ${clang_format[*]} --assume-filename=check.cpp --dump-config"
"${clang_format[@]}" --assume-filename=check.cpp --dump-config >/dev/null || status=1
tracked '*.c' '*.h' '*.cc' '*.cpp' '*.hpp' '*.m' '*.mm'
if [ "${#files[@]}" -eq 0 ]; then
    echo "clang-format: no tracked C/C++/Objective-C files"
elif [ "$fix" -eq 1 ]; then
    run "${clang_format[@]}" -i "${files[@]}"
else
    run "${clang_format[@]}" --dry-run --Werror "${files[@]}"
fi

# C and C++ static analysis (ADR 0002's addendum, #325): clang-tidy with .clang-tidy over every
# translation unit in runtime/ and platform/ that this host builds, never generated or third-party
# code. It reads the compile database of the host's Debug preset, configured (not built) into
# build/tidy. Linux configures it with clang, whose flags clang-tidy understands; another OS's
# own sources (Windows, iOS, Switch) are checked only where they build.
if [ "$tidy" -eq 0 ]; then
    echo "clang-tidy: skipped (--no-tidy)"
else
    case "$(uname -s)" in
        Darwin) tidy_preset=mac-debug ;;
        Linux) tidy_preset=linux-debug ;;
        *) tidy_preset= ;;
    esac
    if [ -z "$tidy_preset" ]; then
        echo "clang-tidy: skipped on $(uname -s) (runs on macOS and Linux)"
    elif ! command -v cmake >/dev/null 2>&1; then
        echo "clang-tidy: cmake not found; it needs a configured build tree (--no-tidy skips it)" >&2
        status=1
    else
        tidy_dir=build/tidy
        configure=(cmake --preset "$tidy_preset" -B "$tidy_dir")
        if [ -n "${MAPLETHIEF_DOWNLOAD_DIR:-}" ]; then
            configure+=("-DMAPLETHIEF_DOWNLOAD_DIR=$MAPLETHIEF_DOWNLOAD_DIR")
        fi
        if [ "$tidy_preset" = linux-debug ] && command -v clang >/dev/null 2>&1; then
            configure+=(-DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++)
        fi
        tidy_args=(-p "$tidy_dir" --quiet)
        if [ "$tidy_preset" = mac-debug ]; then
            # The PyPI build has no default SDK path: libc++ and the system headers are in it.
            tidy_args+=("--extra-arg=-isysroot$(xcrun --show-sdk-path)")
        fi
        echo "+ ${configure[*]}"
        mkdir -p "$tidy_dir"
        if ! "${configure[@]}" >"$tidy_dir/configure.log" 2>&1; then
            cat "$tidy_dir/configure.log" >&2
            status=1
        else
            # The translation units under runtime/ and platform/, once each.
            tidy_files=()
            while IFS= read -r f; do
                tidy_files+=("$f")
            done < <("$python" -I -c '
import json, os, sys
root = os.getcwd()
seen = set()
for e in json.load(open(sys.argv[1], encoding="utf-8")):
    f = os.path.relpath(os.path.normpath(os.path.join(e["directory"], e["file"])), root)
    if f.replace(os.sep, "/").startswith(("runtime/", "platform/")) and f not in seen:
        seen.add(f)
        print(f)
' "$tidy_dir/compile_commands.json")
            jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)"
            clang_tidy=(uvx "clang-tidy@${CLANG_TIDY_VERSION}")
            if [ "${#tidy_files[@]}" -eq 0 ]; then
                echo "clang-tidy: no runtime/ or platform/ files in $tidy_dir" >&2
                status=1
            elif ! "${clang_tidy[@]}" --version >/dev/null; then # installs it before the runs
                status=1
            else
                echo "+ ${clang_tidy[*]} ${tidy_args[*]} (${#tidy_files[@]} files, $jobs at a time)"
                tidy_start=$SECONDS
                printf '%s\0' "${tidy_files[@]}" |
                    xargs -0 -n 1 -P "$jobs" "${clang_tidy[@]}" "${tidy_args[@]}" || status=1
                echo "clang-tidy: $((SECONDS - tidy_start)) s"
            fi
        fi
    fi
fi

# Shell: *.sh files plus extensionless scripts in scripts/ with a sh/bash shebang.
tracked '*.sh' 'scripts/*'
shell_files=()
for f in ${files[@]+"${files[@]}"}; do
    case "$f" in
        *.sh) shell_files+=("$f") ;;
        *.*) ;;
        *) if head -n 1 "$f" | grep -Eq '^#!.*(/|env )(ba)?sh( |$)'; then shell_files+=("$f"); fi ;;
    esac
done
if [ "${#shell_files[@]}" -eq 0 ]; then
    echo "shellcheck: no tracked shell scripts"
else
    run uvx --from "shellcheck-py==${SHELLCHECK_PY_VERSION}" shellcheck "${shell_files[@]}"
fi

# The data folder has one resolver (#261, ADR 0127): no C, C++ or Objective-C source but
# platform/src/data_location.cpp reads MAPLETHIEF_DATA_DIR or calls SDL_GetPrefPath. The runtime's
# own default for builds without the frontend (runtime/src/stubs/stubs.cpp) is the one exception
# the ADR keeps; tests set the variable for the program and are not readers. Comments don't count.
echo "+ data folder: MAPLETHIEF_DATA_DIR and SDL_GetPrefPath only in data_location.cpp"
data_dir_hits="$(git grep -n -E '"MAPLETHIEF_DATA_DIR"|SDL_GetPrefPath[[:space:]]*\(' -- \
    '*.c' '*.h' '*.cc' '*.cpp' '*.hpp' '*.m' '*.mm' \
    ':!platform/src/data_location.cpp' ':!runtime/src/stubs/stubs.cpp' ':!tests/' |
    grep -v -E '^[^:]+:[0-9]+:[[:space:]]*(//|/\*|\*)' || true)"
if [ -n "$data_dir_hits" ]; then
    echo "$data_dir_hits"
    echo "only platform/src/data_location.cpp may read MAPLETHIEF_DATA_DIR or call" \
        "SDL_GetPrefPath (ADR 0127): use data_location()" >&2
    status=1
fi

# Compendium prose (#212, docs/compendium/style.md): standard library only, no uvx needed.
run env PYTHONPATH=tools "$python" -m mtport.prose_lint

if [ "$status" -ne 0 ]; then
    echo "scripts/lint: FAILED" >&2
else
    echo "scripts/lint: OK"
fi
exit "$status"
