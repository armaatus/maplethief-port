#!/usr/bin/env bash
# Build the Android MapleThief.apk (ADR 0150, ADR 0163, issue #356): a CMake workflow preset
# (android-release by default: configure, build, the APK's host-side check, package) on a clean
# export of a commit, in the pinned linux/amd64 image of tools/containers/android/.
#
# Usage: scripts/build-android [REV] [--worktree] [--preset android-release|android-debug]
#                              [--gen DIR] [--image-name]
# (the options are described in usage() below, printed by scripts/build-android --help)
#
# Like CI, the container sees no work/ and no IPA: `git archive` of the commit (Git LFS's smudge
# filter off), and a guard fails the run if the export holds any *.ipa. Without --gen there is no
# generated code, and MapleThief.apk is the placeholder shell. CI=true is set, so warnings are
# errors; MAPLETHIEF_VERSION is passed through when set (ADR 0024). The download cache
# build/_downloads is shared with the host, and holds Gradle's own downloads too
# (android-gradle-home/). On a Mac, `scripts/android-sdk install` and `cmake --workflow --preset
# android-release` build the same APK natively, much faster. Outputs, all below build/:
#   build/<preset>/MapleThief.apk          the APK, signed with the build's debug key
#   build/<preset>/MapleThief-kit-*.zip    the kit (android-release)
#   build/<preset>/logs/                   CTest's log of the APK's check, and ninja_log.txt
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

usage() {
    cat >&2 <<'EOF'
Usage: scripts/build-android [REV] [--worktree] [--preset android-release|android-debug]
                             [--gen DIR] [--image-name]

  REV             commit to build (default: HEAD)
  --worktree      build the working tree's tracked files, uncommitted changes included
                  (`git stash create`; untracked files are left out), instead of REV
  --preset P      the workflow preset: android-release (default: configure, build, check,
                  package) or android-debug (configure, build, check)
  --gen DIR       mount DIR (your own work/gen, from python -m recomp all) read-only and build
                  the generated code into the APK; local only, never in CI. The APK then holds
                  the recompiled code and is never shared (ADR 0100)
  --image-name    build the image if needed, print its name and exit
EOF
    exit "${1:-2}"
}

rev=HEAD
worktree=0
preset=android-release
gen=""
image_name=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --worktree) worktree=1; shift ;;
        --preset)
            [ "$#" -ge 2 ] || usage
            preset="$2"
            shift 2
            ;;
        --gen)
            [ "$#" -ge 2 ] || usage
            gen="$2"
            shift 2
            ;;
        --image-name) image_name=1; shift ;;
        -h | --help) usage 0 ;;
        -*) echo "scripts/build-android: unknown option: $1" >&2; usage ;;
        *) rev="$1"; shift ;;
    esac
done

case "$preset" in
    android-release | android-debug) ;;
    *) echo "scripts/build-android: --preset must be android-release or android-debug" >&2; exit 2 ;;
esac
if ! command -v docker >/dev/null 2>&1; then
    echo "scripts/build-android: docker not found (on a Mac: OrbStack or Docker Desktop)" >&2
    exit 2
fi
if [ -n "$gen" ] && [ ! -f "$gen/gen.cmake" ]; then
    echo "scripts/build-android: no gen.cmake in $gen (python -m recomp all writes it)" >&2
    exit 2
fi

# The image is tagged with a hash of its folder (the Dockerfile, the pins and their installer),
# so a change builds a new one and an unchanged one is reused.
context=tools/containers/android
image_hash="$(cat "$context/Dockerfile" "$context/pins.env" "$context/install-sdk.sh" |
    shasum -a 256 | cut -c1-12)"
image="maplethief-android:$image_hash-amd64"
if ! docker image inspect "$image" >/dev/null 2>&1; then
    echo "== Building $image from $context" >&2
    docker build --platform linux/amd64 -t "$image" "$context" >&2
fi
if [ "$image_name" -eq 1 ]; then
    echo "$image"
    exit 0
fi

if [ "$worktree" -eq 1 ]; then
    commit="$(git stash create)"
    commit="${commit:-$(git rev-parse HEAD)}"
    label="working tree of $(git rev-parse --short HEAD)"
else
    commit="$(git rev-parse --verify "$rev^{commit}")"
    label="$(git rev-parse --short "$commit")"
fi

mkdir -p build/_downloads
downloads="$(cd build/_downloads && pwd -P)"
out="$REPO/build/$preset"
mkdir -p "$out"
# Empty it instead of recreating it (a recreated bind-mount source can vanish under Docker
# Desktop's virtiofs, scripts/test-linux).
find "$out" -mindepth 1 -delete
mounts=(-v "$downloads:/cache/downloads" -v "$out:/out")
if [ -n "${MAPLETHIEF_VERSION:-}" ]; then
    mounts+=(-e MAPLETHIEF_VERSION)
fi
gen_arg=""
if [ -n "$gen" ]; then
    mounts+=(-v "$(cd "$gen" && pwd -P):/src/work/gen:ro")
    gen_arg="-DMAPLETHIEF_GEN_DIR=/src/work/gen"
fi

echo "== Android (amd64) in $image: cmake --workflow --preset $preset on $label"
status=0
git -c filter.lfs.process= -c filter.lfs.smudge=cat -c filter.lfs.required=false \
    archive --format=tar "$commit" |
    docker run --rm -i --platform linux/amd64 "${mounts[@]}" "$image" \
        bash -c '
set -euo pipefail
preset="$1" gen_arg="$2"
untar - /src # not GNU tar, which fails under Rosetta (the Dockerfile)
found=0
while IFS= read -r -d "" f; do
    echo "IPA guard: $f is in the export; the repository must never contain an IPA" >&2
    found=1
done < <(find . -path ./work -prune -o -iname "*.ipa" -print0)
[ "$found" -eq 0 ] || exit 1
echo "IPA guard: OK, no *.ipa in the export"
mkdir -p build
ln -s /cache/downloads build/_downloads
cmake --version | head -n 1
echo "ninja $(ninja --version)"
python3 --version
grep Revision /opt/android-sdk/ndk/*/source.properties
echo "arch $(uname -m)"
status=0
if [ -n "$gen_arg" ]; then
    cmake --preset "$preset" "$gen_arg" || status=$?
fi
[ "$status" -ne 0 ] || cmake --workflow --preset "$preset" || status=$?
mkdir -p /out/logs
for f in "build/$preset/MapleThief.apk" build/"$preset"/MapleThief-*.zip; do
    [ -f "$f" ] && cp "$f" /out/
done
[ ! -f "build/$preset/.ninja_log" ] || cp "build/$preset/.ninja_log" /out/logs/ninja_log.txt
for f in build/"$preset"/Testing/Temporary/LastTest*.log; do
    [ -f "$f" ] && cp "$f" /out/logs/
done
exit "$status"
' bash "$preset" "$gen_arg" || status=$?

if [ -f "$out/MapleThief.apk" ]; then
    echo "== APK: build/$preset/MapleThief.apk ($(wc -c <"$out/MapleThief.apk" | tr -d ' ') bytes)"
fi
for f in "$out"/MapleThief-*.zip; do
    [ -f "$f" ] && echo "== Package: build/$preset/$(basename "$f")"
done
echo "== scripts/build-android ($preset, $label): $([ "$status" -eq 0 ] && echo passed || echo FAILED)"
exit "$status"
