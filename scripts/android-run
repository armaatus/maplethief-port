#!/usr/bin/env bash
# Install and start MapleThief.apk on the arm64 Android emulator of this Mac (ADR 0150, issue
# #356): the agent's device. Creates the AVD for the chosen image if needed, boots it without a
# window, `adb install`s the APK, starts MapleThiefActivity, waits for the start-up log line,
# takes a screenshot and stops the emulator.
#
# Usage: scripts/android-run [APK] [--image 4k|16k] [--seconds S] [--keep]
#
#   APK          default build/android-release/MapleThief.apk
#   --image      the system image: 4k (default, 4 KiB pages) or 16k (16 KiB pages); install it
#                first with scripts/android-sdk install --image 4k|16k
#   --seconds S  how long to wait for the log line after the start (default 60)
#   --keep       leave the emulator running (stop it with: adb -s emulator-5580 emu kill)
#
# Outputs, below build/android-run/<image>/ (git-ignored; screenshots of our own runs never go
# into git): logcat.txt (the app's log), screenshot.png, and the lines it waited for. Exits 0
# only if the APK installed, the activity started, its process logged MapleThief's start-up
# line ("... the placeholder" without the generated code, "... the game" with it) and the
# device reports the expected page size.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SDK="${MAPLETHIEF_ANDROID_SDK:-$REPO/build/_android-sdk}"
PINS="$REPO/tools/containers/android/pins.env"
PACKAGE=io.github.armaatus.maplethief
ACTIVITY="$PACKAGE/.MapleThiefActivity"

apk="$REPO/build/android-release/MapleThief.apk"
image=4k
seconds=60
keep=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --image) image="${2:?}"; shift 2 ;;
        --seconds) seconds="${2:?}"; shift 2 ;;
        --keep) keep=1; shift ;;
        -h | --help) sed -n '/^# Usage:/,/^# Outputs/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        -*) echo "scripts/android-run: unknown option: $1" >&2; exit 2 ;;
        *) apk="$1"; shift ;;
    esac
done
case "$image" in
    4k) key=IMAGE; tag=google_apis; page=4096; port=5580 ;;
    16k) key=IMAGE_PS16K; tag=google_apis_ps16k; page=16384; port=5582 ;;
    *) echo "scripts/android-run: --image is 4k or 16k" >&2; exit 2 ;;
esac
pin() { sed -n "s/^$1=//p" "$PINS"; }
image_path="$(pin "ANDROID_${key}_PATH")"
api="$(pin ANDROID_COMPILE_API)"
for need in "$apk" "$SDK/emulator/emulator" "$SDK/platform-tools/adb" "$SDK/$image_path/system.img"; do
    if [ ! -e "$need" ]; then
        echo "scripts/android-run: $need is missing (scripts/android-sdk install --image $image," \
            "cmake --workflow --preset android-release)" >&2
        exit 2
    fi
done

export ANDROID_HOME="$SDK" ANDROID_SDK_ROOT="$SDK"
export ANDROID_AVD_HOME="$SDK/avd" ANDROID_USER_HOME="$SDK/user-home"
adb="$SDK/platform-tools/adb"
serial="emulator-$port"
name="maplethief-$image"
out="$REPO/build/android-run/$image"
mkdir -p "$ANDROID_AVD_HOME" "$ANDROID_USER_HOME" "$out"
rm -f "$out"/*

# The AVD, written directly (avdmanager needs the cmdline-tools, which the pins leave out).
avd="$ANDROID_AVD_HOME/$name.avd"
if [ ! -f "$avd/config.ini" ]; then
    mkdir -p "$avd"
    cat >"$avd/config.ini" <<EOF
AvdId=$name
avd.ini.displayname=MapleThief $image
abi.type=arm64-v8a
hw.cpu.arch=arm64
hw.cpu.ncore=4
hw.ramSize=3072
hw.lcd.width=1080
hw.lcd.height=2340
hw.lcd.density=420
hw.gpu.enabled=yes
hw.gpu.mode=swiftshader_indirect
hw.keyboard=yes
disk.dataPartition.size=4G
image.sysdir.1=$image_path/
tag.id=$tag
target=android-$api
EOF
    printf 'avd.ini.encoding=UTF-8\npath=%s\npath.rel=avd/%s.avd\ntarget=android-%s\n' \
        "$avd" "$name" "$api" >"$ANDROID_AVD_HOME/$name.ini"
fi

stop() {
    [ "$keep" -eq 1 ] || "$adb" -s "$serial" emu kill >/dev/null 2>&1 || true
}
trap stop EXIT

echo "== Booting $name on port $port"
"$SDK/emulator/emulator" -avd "$name" -port "$port" -no-window -no-audio -no-boot-anim \
    -no-snapshot -gpu swiftshader_indirect >"$out/emulator.txt" 2>&1 &
"$adb" -s "$serial" wait-for-device
for _ in $(seq 1 180); do
    [ "$("$adb" -s "$serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ] && break
    sleep 1
done
[ "$("$adb" -s "$serial" shell getprop sys.boot_completed | tr -d '\r')" = 1 ] ||
    { echo "scripts/android-run: $name did not boot in 3 minutes" >&2; exit 1; }
got_page="$("$adb" -s "$serial" shell getconf PAGESIZE | tr -d '\r')"
release="$("$adb" -s "$serial" shell getprop ro.build.version.release | tr -d '\r')"
echo "== Booted: Android $release, page size $got_page"

status=0
[ "$got_page" = "$page" ] || { echo "scripts/android-run: page size $got_page, expected $page" >&2; status=1; }

echo "== adb install $apk"
"$adb" -s "$serial" install -r "$apk"
"$adb" -s "$serial" logcat -c
# Landscape, as the manifest asks; the emulator's screen is a portrait phone.
"$adb" -s "$serial" shell am start -W -n "$ACTIVITY"
line=""
for _ in $(seq 1 "$seconds"); do
    "$adb" -s "$serial" logcat -d >"$out/logcat.txt"
    line="$(grep -E 'MapleThief [^ ]+, SDL [0-9.]+, video driver' "$out/logcat.txt" | head -n 1 || true)"
    [ -z "$line" ] || break
    sleep 1
done
sleep 3 # a few presented frames before the screenshot
"$adb" -s "$serial" exec-out screencap -p >"$out/screenshot.png"
"$adb" -s "$serial" logcat -d >"$out/logcat.txt"
pid="$("$adb" -s "$serial" shell pidof "$PACKAGE" | tr -d '\r' || true)"
if [ -z "$line" ]; then
    echo "scripts/android-run: no start-up line from MapleThief in ${seconds} s (see $out/logcat.txt)" >&2
    status=1
else
    echo "== Log line: ${line#*: }"
fi
if [ -z "$pid" ]; then
    echo "scripts/android-run: $PACKAGE is not running any more (see $out/logcat.txt)" >&2
    status=1
else
    echo "== Running: pid $pid"
fi
echo "== Screenshot: build/android-run/$image/screenshot.png"
echo "== scripts/android-run ($image): $([ "$status" -eq 0 ] && echo passed || echo FAILED)"
exit "$status"
