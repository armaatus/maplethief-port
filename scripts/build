#!/usr/bin/env bash
# One command from a fresh clone to a playable build (#141, ADR 0133); `just build` calls this,
# and nobody needs just installed. Windows: scripts\build.ps1.
#
#   scripts/build [mac|win|linux|ios|switch] [debug|release]   the game, into dist/<platform>/
#   scripts/build [...] --ipa PATH                  from your own copy of the game (ADR 0135)
#   scripts/build run | bootstrap | assets | recomp | shaders | package | clean | doctor
#
# `macos` and `windows` work too, and a leading dash is ignored (-linux). scripts/build --help
# lists every word. Each step is skipped when it is up to date. Environment: PYTHON=<interpreter>
# (3.10+). The result holds the game: keep it to your own machines.
#
# All the work is done by tools/mtport/build.py; this script only finds a Python to run it.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="${PYTHON:-python3}"

die() { echo "scripts/build: $*" >&2; exit 1; }

command -v "$PY" >/dev/null 2>&1 ||
    die "need Python 3.10+, but '$PY' was not found (set PYTHON=/path/to/python3)"
"$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null ||
    die "need Python 3.10+, but '$PY' is older (set PYTHON=/path/to/python3)"

# A relative --ipa path is the caller's, and this script is about to leave the caller's folder.
export MAPLETHIEF_CALLER_DIR="$PWD"

# -B: write no __pycache__ into tools/.
cd "$REPO"
PYTHONPATH="$REPO/tools${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -B -m mtport.build "$@"
