#!/usr/bin/env bash
# Run CI's Linux job in a container (ADR 0023): scripts/test (or the linux-release workflow
# with --release) on a clean export of a commit, in the pinned Ubuntu 26.04 image of
# tools/containers/linux/Dockerfile, x86_64 by default (Rosetta under OrbStack on a Mac).
#
# Usage: scripts/test-linux [REV] [--worktree] [--release] [--arch amd64|arm64] [--real-assets]
#                           [--build-arg NAME=VALUE]... [-- SCRIPTS_TEST_ARGS...]
#        scripts/test-linux --image-name [--arch amd64|arm64] [--build-arg NAME=VALUE]...
# (the options are described in usage() below, printed by scripts/test-linux --help)
#
# Like CI, the container sees no work/ and no IPA: `git archive` of the commit (the repository
# holds no IPA, ADR 0100; Git LFS's smudge filter stays off all the same), and a guard fails the
# run if the export holds any *.ipa. CI=true is set, so warnings are
# errors, and MAPLETHIEF_VERSION is passed through when set (scripts/release, ADR 0024). The
# download cache build/_downloads is shared with the host, uv's cache lives in a Docker volume
# per architecture. Outputs, all below build/:
#   build/test-linux/<arch>/logs/   CTest logs and build/test-output/ of the run
#   build/linux-release/            the kit (MapleThief-kit-*.tar.gz), with --release
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

usage() {
    cat >&2 <<'EOF'
Usage: scripts/test-linux [REV] [--worktree] [--release] [--arch amd64|arm64] [--real-assets]
                          [--build-arg NAME=VALUE]... [-- SCRIPTS_TEST_ARGS...]
       scripts/test-linux --image-name [--arch amd64|arm64] [--build-arg NAME=VALUE]...

  REV             commit to test (default: HEAD)
  --worktree      test the working tree's tracked files, uncommitted changes included
                  (`git stash create`; untracked files are left out), instead of REV
  --release       run the linux-release workflow (configure, build, test, package) instead
                  of the Debug workflow + pytest; the kit is copied to build/linux-release/
  --arch ARCH     amd64 (default, like ubuntu-latest) or arm64 (native on Apple silicon,
                  much faster, but not what CI runs)
  --real-assets   mount work/ read-only, so the real_assets tests run too (CI never does)
  --build-arg A=B passed to docker build, e.g. --build-arg UBUNTU_SNAPSHOT= to build the
                  image from the live Ubuntu archive while snapshot.ubuntu.com is down
  --image-name    build the image if needed, print its name and exit (scripts/release runs
                  the unpacked Linux kit in it)
  SCRIPTS_TEST_ARGS  passed to scripts/test in the container, e.g. -- --python-only -- -k fat
EOF
    exit "${1:-2}"
}

rev=HEAD
worktree=0
release=0
arch=amd64
real_assets=0
image_name=0
build_args=()
test_args=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --worktree) worktree=1; shift ;;
        --release) release=1; shift ;;
        --arch)
            [ "$#" -ge 2 ] || usage
            arch="$2"
            shift 2
            ;;
        --real-assets) real_assets=1; shift ;;
        --image-name) image_name=1; shift ;;
        --build-arg)
            [ "$#" -ge 2 ] || usage
            build_args+=(--build-arg "$2")
            shift 2
            ;;
        --)
            shift
            test_args=("$@")
            break
            ;;
        -h | --help) usage 0 ;;
        -*) echo "scripts/test-linux: unknown option: $1" >&2; usage ;;
        *) rev="$1"; shift ;;
    esac
done

case "$arch" in
    amd64 | arm64) ;;
    *) echo "scripts/test-linux: --arch must be amd64 or arm64, not $arch" >&2; exit 2 ;;
esac
if ! command -v docker >/dev/null 2>&1; then
    echo "scripts/test-linux: docker not found (on a Mac: OrbStack or Docker Desktop)" >&2
    exit 2
fi

if [ "$image_name" -eq 1 ]; then
    :
elif [ "$worktree" -eq 1 ]; then
    commit="$(git stash create)"
    commit="${commit:-$(git rev-parse HEAD)}"
    label="working tree of $(git rev-parse --short HEAD)"
else
    commit="$(git rev-parse --verify "$rev^{commit}")"
    label="$(git rev-parse --short "$commit")"
fi

# The image is tagged with a hash of its Dockerfile and build arguments, so a change to either
# builds a new one and an unchanged one is reused.
dockerfile=tools/containers/linux/Dockerfile
image_hash="$(
    {
        cat "$dockerfile"
        printf '%s\n' ${build_args[@]+"${build_args[@]}"}
    } | shasum -a 256 | cut -c1-12
)"
image="maplethief-ci-linux:$image_hash-$arch"
if ! docker image inspect "$image" >/dev/null 2>&1; then
    echo "== Building $image from $dockerfile" >&2
    # To stderr: with --image-name, stdout carries the image name only.
    docker build --platform "linux/$arch" ${build_args[@]+"${build_args[@]}"} -t "$image" \
        tools/containers/linux >&2
fi
if [ "$image_name" -eq 1 ]; then
    echo "$image"
    exit 0
fi

mkdir -p build/_downloads
downloads="$(cd build/_downloads && pwd -P)"
out="$REPO/build/test-linux/$arch"
# Empty $out instead of recreating it: Docker Desktop's virtiofs loses a bind mount whose host
# directory was deleted and recreated since an earlier run, and /out then vanishes mid-run.
mkdir -p "$out"
find "$out" -mindepth 1 -delete

if [ "$release" -eq 1 ]; then
    test_cmd=(scripts/test --release)
else
    test_cmd=(scripts/test)
fi
mounts=(
    -v "$downloads:/cache/downloads"
    -v "maplethief-uv-cache-$arch:/cache/uv"
    -v "$out:/out"
)
if [ -n "${MAPLETHIEF_VERSION:-}" ]; then
    mounts+=(-e MAPLETHIEF_VERSION)
fi
if [ "$real_assets" -eq 1 ]; then
    [ -d work/ipa ] || { echo "scripts/test-linux: no work/ipa/; run scripts/bootstrap" >&2; exit 2; }
    mounts+=(-v "$REPO/work:/src/work:ro")
fi

echo "== Linux ($arch) in $image: ${test_cmd[*]} ${test_args[*]+"${test_args[*]}"} on $label"
status=0
# The script runs in the container: unpack the export, guard against IPA content, show the
# toolchain like CI, index the export in a fresh repository, run the tests, then copy logs and the kit to /out.
git -c filter.lfs.process= -c filter.lfs.smudge=cat -c filter.lfs.required=false \
    archive --format=tar "$commit" |
    docker run --rm -i --platform "linux/$arch" "${mounts[@]}" "$image" \
        bash -c '
set -euo pipefail
untar - /src
found=0
while IFS= read -r -d "" f; do
    echo "IPA guard: $f is in the export; the repository must never contain an IPA" >&2
    found=1
done < <(find . -path ./work -prune -o -iname "*.ipa" -print0)
[ "$found" -eq 0 ] || exit 1
echo "IPA guard: OK, no *.ipa in the export"
# A repository over the export, so the tests that ask git (ls-files, check-ignore) see what a
# checkout shows them; indexed before build/ exists, so it holds the exported files only.
git init --quiet
git add -A
mkdir -p build
ln -s /cache/downloads build/_downloads
cmake --version | head -n 1
echo "ninja $(ninja --version)"
c++ --version | head -n 1
clang --version | head -n 1
uv --version
echo "arch $(uname -m)"
status=0
"$@" || status=$?
mkdir -p /out/logs /out/package
cp -R build/test-output /out/logs/ 2>/dev/null || true
for f in build/*/Testing/Temporary/LastTest*.log; do
    [ -f "$f" ] && cp "$f" "/out/logs/$(basename "$(dirname "$(dirname "$(dirname "$f")")")")-$(basename "$f")"
done
for f in build/*/MapleThief-kit-*.tar.gz; do
    [ -f "$f" ] && cp "$f" /out/package/
done
exit "$status"
' bash "${test_cmd[@]}" ${test_args[@]+"${test_args[@]}"} || status=$?

if [ "$release" -eq 1 ]; then
    mkdir -p build/linux-release
    for f in "$out"/package/MapleThief-kit-*.tar.gz; do
        if [ -f "$f" ]; then
            mv "$f" build/linux-release/
            echo "== Kit: build/linux-release/$(basename "$f")"
        fi
    done
fi
echo "== scripts/test-linux ($arch, $label): $([ "$status" -eq 0 ] && echo passed || echo FAILED)"
echo "   logs: build/test-linux/$arch/logs/"
exit "$status"
