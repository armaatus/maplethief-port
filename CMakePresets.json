{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Shared settings: Ninja, output in build/<preset>, one download cache for every preset, test output in build/test-output/<preset> (ADR 0003, ADR 0004, ADR 0005)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "MAPLETHIEF_DOWNLOAD_DIR": "${sourceDir}/build/_downloads",
        "MAPLETHIEF_TEST_OUTPUT_DIR": "${sourceDir}/build/test-output/${presetName}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mac-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      }
    },
    {
      "name": "mac-debug",
      "displayName": "macOS Debug (host architecture)",
      "inherits": "mac-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mac-asan",
      "displayName": "macOS Debug with ASan and UBSan, checked memory model (host architecture)",
      "description": "Every finding aborts; MAPLETHIEF_SANITIZE (ADR 0157, #321)",
      "inherits": "mac-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MAPLETHIEF_MEM_MODEL": "checked",
        "MAPLETHIEF_SANITIZE": "ON"
      }
    },
    {
      "name": "mac-release-universal",
      "displayName": "macOS Release, universal (arm64 + x86_64)",
      "inherits": "mac-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
      }
    },
    {
      "name": "mac-app",
      "displayName": "macOS game app: universal Release MapleThief.app from your own IPA (local only)",
      "description": "Needs work/gen and work/ipa; the IPA's bundle and icon go inside, signed ad hoc, never packaged (ADR 0064)",
      "inherits": "mac-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "MAPLETHIEF_MAC_APP": "ON"
      }
    },
    {
      "name": "mac-player",
      "displayName": "macOS player download: universal Release MapleThief.app with the recompiled code, no bundle",
      "description": "Needs work/gen; the port's own icon, ad-hoc signed, packaged as MapleThief-<version>-macos-universal.zip (ADR 0125)",
      "inherits": "mac-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "MAPLETHIEF_PLAYER_BUILD": "ON"
      }
    },
    {
      "name": "ios-base",
      "hidden": true,
      "inherits": "mac-base",
      "description": "iOS 16+ arm64 through Xcode's generator (needs Xcode). Memory model checked, arena only (ADR 0025); ADR 0136",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "CMAKE_XCODE_GENERATE_SCHEME": "ON",
        "MAPLETHIEF_MEM_MODEL": "checked"
      }
    },
    {
      "name": "ios-app",
      "displayName": "iOS app: MapleThief.app for your own iPhone, from your own IPA (needs Xcode)",
      "description": "Needs work/gen and work/ipa; the IPA's bundle goes inside at build time, never packaged. Signed with MAPLETHIEF_IOS_TEAM (ADR 0136)",
      "inherits": "ios-base",
      "cacheVariables": {
        "MAPLETHIEF_IOS_APP": "ON"
      }
    },
    {
      "name": "ios-ci",
      "displayName": "iOS arm64 of our own code: no generated code, no IPA, no signing (CI)",
      "description": "Compiles and links the frontend and the runtime into the placeholder shell (ADR 0136)",
      "inherits": "ios-base",
      "cacheVariables": {
        "MAPLETHIEF_GEN_DIR": "",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO"
      }
    },
    {
      "name": "win-base",
      "hidden": true,
      "inherits": "base",
      "description": "Ninja + MSVC cl, run from a Visual Studio x64 developer environment",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "win-debug",
      "displayName": "Windows x64 Debug (MSVC)",
      "inherits": "win-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-release",
      "displayName": "Windows x64 Release (MSVC)",
      "inherits": "win-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-player",
      "displayName": "Windows x64 player download (MSVC): the game with the recompiled code, no bundle",
      "description": "Needs work/gen; static MSVC runtime, packaged as MapleThief-<version>-windows-x64.zip (ADR 0125)",
      "inherits": "win-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "MAPLETHIEF_PLAYER_BUILD": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux Debug with ASan and UBSan, checked memory model (clang)",
      "description": "Every finding aborts; MAPLETHIEF_SANITIZE. clang, so that libFuzzer targets can build alongside (ADR 0157, #321)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "MAPLETHIEF_MEM_MODEL": "checked",
        "MAPLETHIEF_SANITIZE": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-player",
      "displayName": "Linux player download: the game with the recompiled code, no bundle",
      "description": "Needs work/gen; built in the linux-game container for glibc 2.39 (scripts/linux-game player), packaged as MapleThief-<version>-linux-x86_64.tar.gz (ADR 0125)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MAPLETHIEF_PLAYER_BUILD": "ON"
      }
    },
    {
      "name": "switch-base",
      "hidden": true,
      "inherits": "base",
      "description": "Nintendo Switch homebrew NRO: devkitA64 with libnx, in the container of tools/containers/switch/ (scripts/build-switch). GCC 15, the Cortex-A57 of the Tegra X1, memory model checked (ADR 0025, ADR 0138)",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{DEVKITPRO}",
        "rhs": ""
      },
      "toolchainFile": "$env{DEVKITPRO}/cmake/Switch.cmake",
      "cacheVariables": {
        "MAPLETHIEF_SWITCH_CPU_FLAGS": "-mcpu=cortex-a57+crypto",
        "MAPLETHIEF_MEM_MODEL": "checked"
      }
    },
    {
      "name": "switch-debug",
      "displayName": "Nintendo Switch Debug: MapleThief.nro and the test NROs (devkitA64 container)",
      "inherits": "switch-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "switch-release",
      "displayName": "Nintendo Switch Release: MapleThief.nro and the test NROs, packaged (devkitA64 container)",
      "inherits": "switch-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "switch-player",
      "displayName": "Nintendo Switch player download: switch-release's MapleThief.nro with the recompiled code, no bundle (devkitA64 container)",
      "description": "Needs work/gen (scripts/build-switch --preset switch-player --gen work/gen); packaged as MapleThief-<version>-switch.zip with switch/maplethief/MapleThief.nro (ADR 0125, #243)",
      "inherits": "switch-release",
      "cacheVariables": {
        "MAPLETHIEF_PLAYER_BUILD": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "mac-debug", "configurePreset": "mac-debug" },
    { "name": "mac-asan", "configurePreset": "mac-asan" },
    { "name": "mac-release-universal", "configurePreset": "mac-release-universal" },
    { "name": "mac-app", "configurePreset": "mac-app" },
    { "name": "mac-player", "configurePreset": "mac-player", "targets": ["MapleThief"] },
    { "name": "ios-app-release", "configurePreset": "ios-app", "configuration": "Release", "targets": ["MapleThief"] },
    { "name": "ios-app-debug", "configurePreset": "ios-app", "configuration": "Debug", "targets": ["MapleThief"] },
    { "name": "ios-ci-debug", "configurePreset": "ios-ci", "configuration": "Debug", "targets": ["MapleThief"] },
    { "name": "ios-ci-release", "configurePreset": "ios-ci", "configuration": "Release", "targets": ["MapleThief"] },
    { "name": "win-debug", "configurePreset": "win-debug" },
    { "name": "win-release", "configurePreset": "win-release" },
    { "name": "win-player", "configurePreset": "win-player", "targets": ["MapleThief"] },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-player", "configurePreset": "linux-player", "targets": ["MapleThief"] },
    { "name": "switch-debug", "configurePreset": "switch-debug" },
    { "name": "switch-release", "configurePreset": "switch-release" },
    { "name": "switch-player", "configurePreset": "switch-player", "targets": ["MapleThief_nro"] }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "player-base",
      "hidden": true,
      "inherits": "test-base",
      "description": "The player build's own checks; its build preset builds only MapleThief (ADR 0125)",
      "filter": { "include": { "name": "^platform\\.(version|player_contents|linux_portable)$" } }
    },
    {
      "name": "asan-base",
      "hidden": true,
      "inherits": "test-base",
      "description": "Sanitizer runs: any finding fails the test; suppressions, each with its reason, in tests/sanitizers/ (ADR 0157)",
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:halt_on_error=1:detect_leaks=0:detect_stack_use_after_return=1:strict_string_checks=1:check_initialization_order=1",
        "UBSAN_OPTIONS": "halt_on_error=1:abort_on_error=1:print_stacktrace=1:report_error_type=1"
      }
    },
    { "name": "mac-debug", "inherits": "test-base", "configurePreset": "mac-debug" },
    { "name": "mac-asan", "inherits": "asan-base", "configurePreset": "mac-asan" },
    { "name": "mac-release-universal", "inherits": "test-base", "configurePreset": "mac-release-universal" },
    { "name": "mac-app", "inherits": "test-base", "configurePreset": "mac-app" },
    { "name": "mac-player", "inherits": "player-base", "configurePreset": "mac-player" },
    { "name": "win-debug", "inherits": "test-base", "configurePreset": "win-debug" },
    { "name": "win-release", "inherits": "test-base", "configurePreset": "win-release" },
    { "name": "win-player", "inherits": "player-base", "configurePreset": "win-player" },
    { "name": "linux-debug", "inherits": "test-base", "configurePreset": "linux-debug" },
    { "name": "linux-asan", "inherits": "asan-base", "configurePreset": "linux-asan" },
    { "name": "linux-release", "inherits": "test-base", "configurePreset": "linux-release" },
    { "name": "linux-player", "inherits": "player-base", "configurePreset": "linux-player" },
    {
      "name": "switch-checks",
      "hidden": true,
      "inherits": "test-base",
      "description": "The host-side checks of the NRO only; the doctest programs are NROs that run on a console (#235)",
      "filter": { "include": { "name": "^platform\\.switch_" } }
    },
    { "name": "switch-debug", "inherits": "switch-checks", "configurePreset": "switch-debug" },
    { "name": "switch-release", "inherits": "switch-checks", "configurePreset": "switch-release" },
    {
      "name": "switch-player",
      "inherits": "test-base",
      "configurePreset": "switch-player",
      "description": "The NRO's host-side checks (its version, the guard's player mode) and the player build's own",
      "filter": { "include": { "name": "^platform\\.(switch_nro|switch_guard|player_contents)$" } }
    }
  ],
  "packagePresets": [
    { "name": "mac-release-universal", "configurePreset": "mac-release-universal" },
    { "name": "mac-player", "configurePreset": "mac-player" },
    { "name": "win-release", "configurePreset": "win-release" },
    { "name": "win-player", "configurePreset": "win-player" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-player", "configurePreset": "linux-player" },
    { "name": "switch-release", "configurePreset": "switch-release" },
    { "name": "switch-player", "configurePreset": "switch-player" }
  ],
  "workflowPresets": [
    {
      "name": "mac-debug",
      "steps": [
        { "type": "configure", "name": "mac-debug" },
        { "type": "build", "name": "mac-debug" },
        { "type": "test", "name": "mac-debug" }
      ]
    },
    {
      "name": "mac-asan",
      "steps": [
        { "type": "configure", "name": "mac-asan" },
        { "type": "build", "name": "mac-asan" },
        { "type": "test", "name": "mac-asan" }
      ]
    },
    {
      "name": "mac-release-universal",
      "steps": [
        { "type": "configure", "name": "mac-release-universal" },
        { "type": "build", "name": "mac-release-universal" },
        { "type": "test", "name": "mac-release-universal" },
        { "type": "package", "name": "mac-release-universal" }
      ]
    },
    {
      "name": "mac-app",
      "steps": [
        { "type": "configure", "name": "mac-app" },
        { "type": "build", "name": "mac-app" }
      ]
    },
    {
      "name": "ios-ci",
      "steps": [
        { "type": "configure", "name": "ios-ci" },
        { "type": "build", "name": "ios-ci-debug" },
        { "type": "build", "name": "ios-ci-release" }
      ]
    },
    {
      "name": "win-debug",
      "steps": [
        { "type": "configure", "name": "win-debug" },
        { "type": "build", "name": "win-debug" },
        { "type": "test", "name": "win-debug" }
      ]
    },
    {
      "name": "win-release",
      "steps": [
        { "type": "configure", "name": "win-release" },
        { "type": "build", "name": "win-release" },
        { "type": "test", "name": "win-release" },
        { "type": "package", "name": "win-release" }
      ]
    },
    {
      "name": "linux-debug",
      "steps": [
        { "type": "configure", "name": "linux-debug" },
        { "type": "build", "name": "linux-debug" },
        { "type": "test", "name": "linux-debug" }
      ]
    },
    {
      "name": "linux-asan",
      "steps": [
        { "type": "configure", "name": "linux-asan" },
        { "type": "build", "name": "linux-asan" },
        { "type": "test", "name": "linux-asan" }
      ]
    },
    {
      "name": "linux-release",
      "steps": [
        { "type": "configure", "name": "linux-release" },
        { "type": "build", "name": "linux-release" },
        { "type": "test", "name": "linux-release" },
        { "type": "package", "name": "linux-release" }
      ]
    },
    {
      "name": "mac-player",
      "steps": [
        { "type": "configure", "name": "mac-player" },
        { "type": "build", "name": "mac-player" },
        { "type": "test", "name": "mac-player" },
        { "type": "package", "name": "mac-player" }
      ]
    },
    {
      "name": "win-player",
      "steps": [
        { "type": "configure", "name": "win-player" },
        { "type": "build", "name": "win-player" },
        { "type": "test", "name": "win-player" },
        { "type": "package", "name": "win-player" }
      ]
    },
    {
      "name": "linux-player",
      "steps": [
        { "type": "configure", "name": "linux-player" },
        { "type": "build", "name": "linux-player" },
        { "type": "test", "name": "linux-player" },
        { "type": "package", "name": "linux-player" }
      ]
    },
    {
      "name": "switch-debug",
      "steps": [
        { "type": "configure", "name": "switch-debug" },
        { "type": "build", "name": "switch-debug" },
        { "type": "test", "name": "switch-debug" }
      ]
    },
    {
      "name": "switch-release",
      "steps": [
        { "type": "configure", "name": "switch-release" },
        { "type": "build", "name": "switch-release" },
        { "type": "test", "name": "switch-release" },
        { "type": "package", "name": "switch-release" }
      ]
    },
    {
      "name": "switch-player",
      "steps": [
        { "type": "configure", "name": "switch-player" },
        { "type": "build", "name": "switch-player" },
        { "type": "test", "name": "switch-player" },
        { "type": "package", "name": "switch-player" }
      ]
    }
  ]
}
