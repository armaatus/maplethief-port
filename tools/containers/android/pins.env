# The Android toolchain's pins (ADR 0150, ADR 0163, issue #356): the one file that the native
# install on the Mac (scripts/android-sdk, into build/_android-sdk/) and the container
# (tools/containers/android/Dockerfile) both read, through install-sdk.sh beside it. CMake
# (cmake/AndroidToolchain.cmake) and Gradle (platform/android/settings.gradle) read the
# versions from here too.
#
# Plain KEY=value lines, no quotes and no shell: bash sources it, CMake and Gradle parse it.
# Each archive is "<url> <sha256>", taken from Google's SDK repository (repository2-3.xml,
# sys-img/google_apis/sys-img2-3.xml), Adoptium and Gradle; the SHA-256 is ours, computed on
# 2026-11-26 from the downloaded file (Google publishes SHA-1 only). Bump one pin per commit and
# say why.

# Versions (ADR 0150).
ANDROID_NDK_VERSION=28.2.13676358
ANDROID_COMPILE_API=35
ANDROID_MIN_API=26
ANDROID_BUILD_TOOLS_VERSION=35.0.0
ANDROID_AGP_VERSION=8.7.3
ANDROID_GRADLE_VERSION=8.12
ANDROID_JDK_VERSION=17.0.21.1+2

# Where each package goes below the SDK root (sdkmanager's layout, so the emulator and the
# Android Gradle Plugin find them).
ANDROID_NDK_PATH=ndk/28.2.13676358
ANDROID_PLATFORM_PATH=platforms/android-35
ANDROID_BUILD_TOOLS_PATH=build-tools/35.0.0
ANDROID_PLATFORM_TOOLS_PATH=platform-tools
ANDROID_EMULATOR_PATH=emulator
ANDROID_IMAGE_PATH=system-images/android-35/google_apis/arm64-v8a
ANDROID_IMAGE_PS16K_PATH=system-images/android-35/google_apis_ps16k/arm64-v8a
ANDROID_JDK_PATH=jdk-17
ANDROID_GRADLE_PATH=gradle-8.12

# NDK r28c (28.2.13676358), SDL 3.4.18's tested NDK.
ANDROID_NDK_DARWIN=https://dl.google.com/android/repository/android-ndk-r28c-darwin.zip 0d4599e8bbf1a1668a0d51a541729b2246360f350018a2081d0b302dbb594f2a
ANDROID_NDK_LINUX=https://dl.google.com/android/repository/android-ndk-r28c-linux.zip dfb20d396df28ca02a8c708314b814a4d961dc9074f9a161932746f815aa552f
# platforms;android-35, revision 2 (the same archive on every host).
ANDROID_PLATFORM_DARWIN=https://dl.google.com/android/repository/platform-35_r02.zip 0988cacad01b38a18a47bac14a0695f246bc76c1b06c0eeb8eb0dc825ab0c8e0
ANDROID_PLATFORM_LINUX=https://dl.google.com/android/repository/platform-35_r02.zip 0988cacad01b38a18a47bac14a0695f246bc76c1b06c0eeb8eb0dc825ab0c8e0
# build-tools;35.0.0 (aapt2, zipalign, apksigner, d8).
ANDROID_BUILD_TOOLS_DARWIN=https://dl.google.com/android/repository/build-tools_r35_macosx.zip 530cdbd1ec315e1477624d7ed2f0f2962108d69f36eddba5894cef9ea2cedb48
ANDROID_BUILD_TOOLS_LINUX=https://dl.google.com/android/repository/build-tools_r35_linux.zip bd3a4966912eb8b30ed0d00b0cda6b6543b949d5ffe00bea54c04c81e1561d88
# platform-tools 37.0.3 (adb); the Mac only: the container builds, it runs nothing.
ANDROID_PLATFORM_TOOLS_DARWIN=https://dl.google.com/android/repository/platform-tools_r37.0.3-darwin.zip df21339b9371fef9b19264404338dc686f59a88a1dce634b963da344909001d6
# emulator 37.4.2 (build 16982698), Apple silicon; the Mac only.
ANDROID_EMULATOR_DARWIN=https://dl.google.com/android/repository/emulator-darwin_aarch64-16982698.zip 1f3428521381c850ac988847c39e844e1be16ac9d3146902252b369d8a717aba
# system-images;android-35;google_apis;arm64-v8a revision 9 (4 KiB pages) and
# system-images;android-35;google_apis_ps16k;arm64-v8a revision 5 (16 KiB pages); the Mac only.
ANDROID_IMAGE_DARWIN=https://dl.google.com/android/repository/sys-img/google_apis/arm64-v8a-35_r09.zip d2e7c6076e5df54d3677605a324daf9edf813b2808c216bdb1687f6b2b6aed99
ANDROID_IMAGE_PS16K_DARWIN=https://dl.google.com/android/repository/sys-img/google_apis/arm64-v8a-ps16k-35_r05.zip @IMG16@
# Eclipse Temurin JDK 17.0.21.1+2 (Gradle and the Android Gradle Plugin 8.7 need 17).
ANDROID_JDK_DARWIN=https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.21.1%2B2/OpenJDK17U-jdk_aarch64_mac_hotspot_17.0.21.1_2.tar.gz 2a88ccb044a8fb00957be93245da6357c11b55717511509d147cbcc5d93b2109
ANDROID_JDK_LINUX=https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.21.1%2B2/OpenJDK17U-jdk_x64_linux_hotspot_17.0.21.1_2.tar.gz 0b0ac5eab6db6abaec68c9913bcddb31321e5da411c45073d520d9c125e6f7b4
# Gradle 8.12 (its distributionSha256Sum from services.gradle.org).
ANDROID_GRADLE_DARWIN=https://services.gradle.org/distributions/gradle-8.12-bin.zip 7a00d51fb93147819aab76024feece20b6b84e420694101f276be952e08bef03
ANDROID_GRADLE_LINUX=https://services.gradle.org/distributions/gradle-8.12-bin.zip 7a00d51fb93147819aab76024feece20b6b84e420694101f276be952e08bef03
