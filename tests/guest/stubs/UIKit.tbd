--- !tapi-tbd
# The guest program's link stub (#385, ADR 0213): the symbols it imports, under the install
# name the game imports them from. Written by hand; no SDK file.
tbd-version: 4
targets: [ armv7-ios ]
install-name: '/System/Library/Frameworks/UIKit.framework/UIKit'
exports:
  - targets: [ armv7-ios ]
    symbols: [ _UIApplicationMain ]
    objc-classes: [ UIResponder, UIView, UIWindow ]
...
