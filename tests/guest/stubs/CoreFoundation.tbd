--- !tapi-tbd
# The guest program's link stub (#385, ADR 0213): the symbols it imports, under the install
# name the game imports them from. Written by hand; no SDK file.
tbd-version: 4
targets: [ armv7-ios ]
install-name: '/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation'
exports:
  - targets: [ armv7-ios ]
    symbols: [ ___CFConstantStringClassReference, _CFAbsoluteTimeGetCurrent, _CFBundleCopyResourceURLForLocalization, _CFBundleGetMainBundle, _CFDataGetBytePtr, _CFDataGetLength, _CFRelease, _CFRunLoopAddTimer, _CFRunLoopGetCurrent, _CFRunLoopTimerCreate, _CFStringCreateWithCString, _CFURLCreateDataAndPropertiesFromResource, _kCFAllocatorDefault, _kCFRunLoopDefaultMode ]
...
