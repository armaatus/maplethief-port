--- !tapi-tbd
# The guest program's link stub (#385, ADR 0213): the symbols it imports, under the install
# name the game imports them from. Written by hand; no SDK file.
tbd-version: 4
targets: [ armv7-ios ]
install-name: '/usr/lib/libobjc.A.dylib'
exports:
  - targets: [ armv7-ios ]
    symbols: [ _objc_msgSend, _objc_msgSendSuper2, __objc_empty_cache ]
    objc-classes: [ NSObject ]
...
