--- !tapi-tbd
# The guest program's link stub (#385, ADR 0213): the symbols it imports, under the install
# name the game imports them from. Written by hand; no SDK file.
tbd-version: 4
targets: [ armv7-ios ]
install-name: '/usr/lib/libstdc++.6.dylib'
exports:
  - targets: [ armv7-ios ]
    symbols: [ ___cxa_allocate_exception, ___cxa_begin_catch, ___cxa_end_catch, ___cxa_throw, ___gxx_personality_sj0, __ZdlPv, __ZTVN10__cxxabiv117__class_type_infoE, __ZTVN10__cxxabiv120__si_class_type_infoE ]
...
