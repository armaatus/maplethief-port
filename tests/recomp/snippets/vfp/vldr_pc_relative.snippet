title: vldr s/d from literals before and after the code: base = Align(PC, 4), offsets +-imm8 * 4
ref: A8.8 VLDR T1, T2: base = if n == 15 then Align(PC, 4) else R[n]; address = base +/- imm32

[code]
06e0        b start
0000        .short 0
0000c03f    .long 0x3FC00000
00000000    .long 0
00000440    .long 0x40040000
start:
1fed040a    vldr s0, [pc, #-16]
1fed041b    vldr d1, [pc, #-16]
dfed020a    vldr s1, [pc, #8]
9fed022b    vldr d2, [pc, #8]
7047        bx lr
0000        .short 0
000000c0    .long 0xC0000000
00000000    .long 0
0000f8bf    .long 0xBFF80000

[out]
s0 = 0x3FC00000
d1 = 0x4004000000000000
s1 = 0xC0000000
d2 = 0xBFF8000000000000
