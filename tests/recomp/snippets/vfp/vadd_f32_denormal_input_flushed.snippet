title: vadd.f32 / vadd.f64 flush a denormal input to zero (FPSCR.FZ = 1 on iOS)
ref: A2.7 FPAdd(), FPUnpack(): with FPSCR = 0x03000000 on iOS (DN, FZ, round to nearest; ADR 0022) a denormal operand is zero, so 2^-149 + 2^-126 = 2^-126

[code]
30ee201a    vadd.f32 s2, s0, s1
34ee053b    vadd.f64 d3, d4, d5
7047        bx lr

[in]
s0 = 0x00000001
s1 = 0x00800000
d4 = 0x0000000000000001
d5 = 0x0010000000000000

[out]
s2 = 0x00800000
d3 = 0x0010000000000000
