title: vmov s4, s5, r2, r3 moves two core registers to two singles
ref: A8.8 VMOV (between two ARM core registers and two single-precision registers) T1
xfail: #34 lifts vmov with two single registers (not decoded yet)

[code]
43ec122a    vmov s4, s5, r2, r3
51ec120a    vmov r0, r1, s4, s5
7047        bx lr

[in]
r2 = 0xCCCC0000
r3 = 0xDDDD0000

[out]
d2 = 0xDDDD0000CCCC0000
r0 = 0xCCCC0000
r1 = 0xDDDD0000
