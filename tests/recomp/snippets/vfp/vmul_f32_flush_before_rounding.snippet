title: vmul.f32: 2^-126 - 2^-150 is flushed although it rounds to 2^-126; just above 2^-126 rounds to it
ref: A2.7 FPMul(), FPRound(): with FPSCR = 0x03000000 on iOS (DN, FZ, round to nearest; ADR 0022) flush-to-zero tests the exponent of the exact result before rounding

[code]
20ee201a    vmul.f32 s2, s0, s1
60ee021a    vmul.f32 s3, s0, s4
7047        bx lr

[in]
s0 = 0x3F7FFFFF     # 1 - 2^-24
s1 = 0x00800000     # 2^-126
s4 = 0x00800001     # 2^-126 (1 + 2^-23): the product is 2^-126 (1 + 2^-24 - 2^-47)

[out]
s2 = 0
s3 = 0x00800000
