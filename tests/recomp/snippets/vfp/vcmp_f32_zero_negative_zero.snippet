title: vcmp.f32 -0.0 with #0 compares equal
ref: A8.8 VCMP, VCMPE; A2.7 FPCompare(); A8.8 VMRS (APSR_nzcv): less 1000, equal 0110, greater 0010, unordered 0011; -0 == +0

[code]
b5ee400a    vcmp.f32 s0, #0
f1ee10fa    vmrs APSR_nzcv, fpscr
7047        bx lr

[in]
s0 = 0x80000000

[out]
flags = nZCv
