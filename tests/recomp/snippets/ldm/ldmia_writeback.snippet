title: ldm r0!, {r1-r3} loads three words and advances r0
ref: A8.8 LDM/LDMIA/LDMFD (Thumb): lowest register from the lowest address T1

[code]
0ec8        ldm r0!, {r1, r2, r3}
7047        bx lr

[in]
r0 = DATA
word DATA = 0x11111111 0x22222222 0x33333333 0x44444444

[out]
r0 = DATA+12
r1 = 0x11111111
r2 = 0x22222222
r3 = 0x33333333
