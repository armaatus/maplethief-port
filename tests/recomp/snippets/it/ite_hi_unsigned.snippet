title: ite hi compares unsigned: 0xFFFFFFFE is higher than 3
ref: A8.8 IT; A2.5.2 ITSTATE: each instruction in the block is conditional on its own condition; A8.3 ConditionPassed(): hi is C == 1 and Z == 0

[code]
8842        cmp r0, r1
8cbf        ite hi
0122        movhi r2, #1
0022        movls r2, #0
7047        bx lr

[in]
r0 = 0xFFFFFFFE
r1 = 3

[out]
r2 = 1
flags = NzCv
