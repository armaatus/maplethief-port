title: a cmp inside an IT block decides the next instruction
ref: A8.8 IT; A2.5.2 ITSTATE: each instruction in the block is conditional on its own condition; A8.8 CMP (register) T1 inside IT still sets the flags

[code]
8842        cmp r0, r1
04bf        itt eq
9a42        cmpeq r2, r3
0124        moveq r4, #1
7047        bx lr

[in]
r0 = 1
r1 = 1
r2 = 5
r3 = 6

[out]
flags = Nzcv
