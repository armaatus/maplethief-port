# r0 == 1: blxeq calls the ARM function (lr = the next instruction, Thumb bit set), blxne r3
# is skipped, and popeq returns before the movs. The flags are compared again after each
# call (AAPCS leaves them undefined). clang leaves blx to an ARM label as a relocation, so
# its bytes are by hand (Capstone checks them).
title: blx #imm, blx rN and pop {..., pc} inside IT blocks (eq taken)
ref: A8.8 IT; BL, BLX (immediate) T2: targetAddress = Align(PC, 4) + imm32; BLX (register) T1; POP (Thumb) T1 in an IT block

[code]
10b5        push {r4, lr}
0128        cmp r0, #1
08bf        it eq
01f0fcef    blxeq arm_3000
0128        cmp r0, #1
18bf        it ne
9847        blxne r3
0128        cmp r0, #1
08bf        it eq
10bd        popeq {r4, pc}
ee22        movs r2, #0xee
10bd        pop {r4, pc}

[in]
r0 = 1
r3 = 0x2001
r4 = 0x4444

[out]
r1 = 0x10
r5 = BASE+0xB
r14 = BASE+0xB
word SP0-8 = 0x4444 RET
flags = nZCv

[c]
void f_00003000(mt_cpu *MT_RESTRICT cpu) {
    cpu->r[1] += 0x10u;
    cpu->r[5] = cpu->r[14];
}
void thumb_target(mt_cpu *MT_RESTRICT cpu) {
    cpu->r[1] += 0x100u;
    cpu->r[6] = cpu->r[14];
}

[dispatch]
0x2001 = thumb_target
