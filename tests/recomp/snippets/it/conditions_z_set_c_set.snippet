title: eq, hi, ge, le, lt and lo with Z and C set
ref: A8.8 IT; A2.5.2 ITSTATE: each instruction in the block is conditional on its own condition; A8.3 ConditionPassed()

[code]
0cbf        ite eq
0120        moveq r0, #1
0220        movne r0, #2
8cbf        ite hi
0121        movhi r1, #1
0221        movls r1, #2
acbf        ite ge
0122        movge r2, #1
0222        movlt r2, #2
d4bf        ite le
0123        movle r3, #1
0223        movgt r3, #2
b4bf        ite lt
0124        movlt r4, #1
0224        movge r4, #2
34bf        ite lo
0125        movlo r5, #1
0225        movhs r5, #2
7047        bx lr

[in]
flags = nZCv

[out]
r0 = 1
r1 = 2
r2 = 1
r3 = 1
r4 = 2
r5 = 2
