# Every load and store addresses [rn] with no offset. 0x80 sign-extends to 0xFFFFFF80 and
# 0x8001 to 0xFFFF8001. strb, strh and strd write DATA+0x10.., DATA+0x14.., DATA+0x18..
title: loads and stores of every size at [rn] with no offset
ref: A8.8 LDR (immediate) T1, LDRB (immediate) T1, LDRH (immediate) T1, LDRSB (immediate) T1, LDRSH (immediate) T1, STRB (immediate) T1, STRH (immediate) T1, STRD (immediate) T1

[code]
0168        ldr r1, [r0]
0278        ldrb r2, [r0]
0388        ldrh r3, [r0]
90f90040    ldrsb.w r4, [r0]
b6f90050    ldrsh.w r5, [r6]
3970        strb r1, [r7]
0437        adds r7, #4
3980        strh r1, [r7]
0437        adds r7, #4
c7e90016    strd r1, r6, [r7]
7047        bx lr

[in]
r0 = DATA
r6 = DATA+4
r7 = DATA+0x10
word DATA = 0x12348080 0x00008001
word DATA+0x10 = 0xFFFFFFFF 0xFFFFFFFF

[out]
r1 = 0x12348080
r2 = 0x80
r3 = 0x8080
r4 = 0xFFFFFF80
r5 = 0xFFFF8001
r7 = DATA+0x18
word DATA+0x10 = 0xFFFFFF80 0xFFFF8080 0x12348080 DATA+4
flags = nzcv
