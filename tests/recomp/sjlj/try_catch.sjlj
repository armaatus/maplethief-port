[in]
# LSDA: no LPStart, absptr type table 16 bytes after its offset field, ULEB128 call sites,
# 2 bytes of them: call site 1 -> landing pad 0, action 1. Actions: (1, next +1) and (2, end).
# Types: [2] = 0x6000 (B) at base - 8, [1] = 0x5000 (A) at base - 4.
byte DATA+0x100 = 0xff 0x00 0x10 0x01 0x02 0x00 0x01 0x01 0x01 0x02 0x00
word DATA+0x10B = 0x6000 0x5000

[out]
r0 = 2
word DATA = 4                 # log entries
word DATA+4 = 1 0x7700 2 0x7701
