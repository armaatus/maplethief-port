# try { middle(round); } catch (A) { log; } catch (B) { log; }, two rounds: middle is a plain
# function (no context of its own) that throws A in round 0 and B in round 1. The handler
# of main gets selector 1, then 2, and the object middle threw. main keeps its round counter
# in its frame (sp+0x2c): after the longjmp only r7 and sp are restored.
title: try/catch with two typed handlers, entered twice through a frame without a context
ref: GCC unwind-sjlj.c (_Unwind_SjLj_RaiseException: search phase, then cleanup phase to the handler); libsupc++ eh_personality.cc (SjLj call sites, handler_switch_value); ADR 0020

[code]
fn_main:
f0b5        push {r4, r5, r6, r7, lr}
03af        add r7, sp, #0xc
8cb0        sub sp, #0x30
49f20110    movw r0, #0x9101            @ the personality
0690        str r0, [sp, #0x18]
40f20010    movw r0, #0x100             @ the LSDA at DATA+0x100
c0f21000    movt r0, #0x10
0790        str r0, [sp, #0x1c]
0897        str r7, [sp, #0x20]         @ jbuf[0] = r7
6846        mov r0, sp
