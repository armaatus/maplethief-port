[in]
# main: type table 0x9B; call site 1 -> pad 0, action 1 = (filter 1, end); 3 bytes of
# alignment, then type [1] at DATA+0x10C: DATA+0x180 - DATA+0x10C = 0x74, which holds A.
byte DATA+0x100 = 0xff 0x9b 0x0d 0x01 0x02 0x00 0x01 0x01 0x00 0x00 0x00 0x00
word DATA+0x10C = 0x74
word DATA+0x180 = 0x5000
# mid: call site 1 -> pad 0, action 1 = (filter 1 = B, next +1) then (0: cleanup, end).
byte DATA+0x120 = 0xff 0x00 0x0e 0x03 0x82 0x80 0x00 0x00 0x01 0x01 0x01 0x00 0x00
word DATA+0x12D = 0x6000
# skip and leaf: call site 1 -> pad 0, cleanup only; no type table.
byte DATA+0x140 = 0xff 0xff 0x01 0x02 0x00 0x00
byte DATA+0x150 = 0xff 0xff 0x01 0x02 0x00 0x00

[out]
word DATA = 5
word DATA+4 = 0xc1 0 1 0x7a 0     # leaf, mid (selector 0), main (selector, object), none live
