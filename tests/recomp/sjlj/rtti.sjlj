# try { middle(round); } catch (B) { log; } catch (Base) { log; } catch (...) { log; }, four
# rounds, with RTTI (#45, ADR 0031). middle throws the type and object of entry `round` of a
# table at DATA+0x400:
#   0: Mid, where Mid : Derived : Base are __si_class_type_info. The catch clause's Base is a
#      second type_info object with its own copy of the name "4Base" (type_info::operator==
#      compares names), so only walking Mid -> Derived -> Base finds it: selector 2, object
#      unchanged.
#   1: Multi : Other, B (B at +8), an __vmi_class_type_info: catch (B) gets the B subobject,
#      object + 8 (GCC's adjustedPtr): selector 1.
#   2: Priv : private Base: no public Base, so catch (...): selector 3.
#   3: Ambig : Derived, Mid (Mid at +16): two Base subobjects, ambiguous, so catch (...).
# The handler logs the selector and what begin_catch returns. The type_info vtables are at
# 0x9200 / 0x9240 / 0x9280 (tests/test_recomp_sjlj.py), so a vptr is 0x9208, 0x9248 or 0x9288.
title: catch clauses matched by RTTI: an __si_class_type_info chain, an __vmi_ base at an offset, a private and an ambiguous base
ref: libsupc++ tinfo.cc (type_info::operator== compares names), tinfo2.cc / class_type_info.cc (__class_type_info::__do_catch, __si_ and __vmi_class_type_info::__do_upcast); eh_personality.cc (adjustedPtr); Itanium C++ ABI 2.9.5; ADR 0031

[code]
fn_main:
f0b5        push {r4, r5, r6, r7, lr}
03af        add r7, sp, #0xc
8cb0        sub sp, #0x30
49f20110    movw r0, #0x9101            @ the personality
0690        str r0, [sp, #0x18]
40f20010    movw r0, #0x100             @ the LSDA at DATA+0x100
c0f21000    movt r0, #0x10
0790        str r0, [sp, #0x1c]
0897        str r7, [sp, #0x20]         @ jbuf[0] = r7
6846        mov r0, sp
0a90        str r0, [sp, #0x28]         @ jbuf[2] = sp
08ad        add r5, sp, #0x20
7c46        mov r4, pc
e41d        adds r4, r4, #7
6c60        str r4, [r5, #4]            @ jbuf[1] = main_resume | 1
0020        movs r0, #0
00e0        b main_join
main_resume:
0120        movs r0, #1
main_join:
0028        cmp r0, #0
17d1        bne main_dispatch
6846        mov r0, sp
07f0e6ff    bl ext_9000                 @ _Unwind_SjLj_Register
0020        movs r0, #0
0b90        str r0, [sp, #0x2c]         @ round = 0
main_loop:
0120        movs r0, #1
0190        str r0, [sp, #4]            @ call_site = 1
0b98        ldr r0, [sp, #0x2c]
00f01df8    bl fn_middle
main_next:
4ff0ff30    mov.w r0, #-1
0190        str r0, [sp, #4]            @ call_site = -1
0b98        ldr r0, [sp, #0x2c]
0130        adds r0, #1
0b90        str r0, [sp, #0x2c]
0428        cmp r0, #4
f2db        blt main_loop
6846        mov r0, sp
07f0dcff    bl ext_9010                 @ _Unwind_SjLj_Unregister
0b98        ldr r0, [sp, #0x2c]
0cb0        add sp, #0x30
f0bd        pop {r4, r5, r6, r7, pc}
main_dispatch:
0198        ldr r0, [sp, #4]            @ the landing-pad index
0028        cmp r0, #0
0ad1        bne main_bad
0398        ldr r0, [sp, #0xc]          @ data[1]: the selector
08f003f8    bl ext_9070                 @ log
0298        ldr r0, [sp, #8]            @ data[0]: the exception
07f0e8ff    bl ext_9040                 @ begin_catch: the (adjusted) object
07f0feff    bl ext_9070                 @ log
07f0ecff    bl ext_9050                 @ end_catch
e3e7        b main_next
main_bad:
fede        trap
fn_middle:
80b5        push {r7, lr}
6f46        mov r7, sp
40f20042    movw r2, #0x400
c0f21002    movt r2, #0x10              @ the throw table at DATA+0x400
02ebc002    add.w r2, r2, r0, lsl #3    @ entry `round`: {type, object}
1068        ldr r0, [r2]                @ the type
5168        ldr r1, [r2, #4]            @ the object
07f0ceff    bl ext_9030                 @ throw (r0 = type, r1 = object)
80bd        pop {r7, pc}

[in]
# LSDA: no LPStart, absptr type table 0x16 bytes after its offset field, ULEB128 call sites,
# 2 bytes of them: call site 1 -> landing pad 0, action 1. Actions: (1, next +1), (2, next
# +1), (3, end). Types: [3] = 0 (catch (...)) at base - 12, [2] = Base (the copy) at
# base - 8, [1] = B at base - 4; base = DATA+0x119.
byte DATA+0x100 = 0xff 0x00 0x16 0x01 0x02 0x00 0x01 0x01 0x01 0x02 0x01 0x03 0x00
word DATA+0x10D = 0 DATA+0x208 DATA+0x210
# type_info objects: {vptr, name} for __class_type_info, + base for __si_, + flags, count,
# {base, offset << 8 | public 2 | virtual 1}... for __vmi_.
word DATA+0x200 = 0x9208 DATA+0x300                                  # Base
word DATA+0x208 = 0x9208 DATA+0x308                                  # Base (a second copy)
word DATA+0x210 = 0x9208 DATA+0x310                                  # B
word DATA+0x218 = 0x9208 DATA+0x318                                  # Other
word DATA+0x220 = 0x9248 DATA+0x320 DATA+0x200                       # Derived : Base
word DATA+0x230 = 0x9248 DATA+0x330 DATA+0x220                       # Mid : Derived
word DATA+0x240 = 0x9288 DATA+0x338 0 2 DATA+0x218 0x2 DATA+0x210 0x802    # Multi
word DATA+0x260 = 0x9288 DATA+0x340 0 1 DATA+0x200 0x0                     # Priv
word DATA+0x280 = 0x9288 DATA+0x348 1 2 DATA+0x220 0x2 DATA+0x230 0x1002   # Ambig
# names: "4Base" twice, "1B", "5Other", "7Derived", "3Mid", "5Multi", "4Priv", "5Ambig"
byte DATA+0x300 = 0x34 0x42 0x61 0x73 0x65 0x00
byte DATA+0x308 = 0x34 0x42 0x61 0x73 0x65 0x00
byte DATA+0x310 = 0x31 0x42 0x00
byte DATA+0x318 = 0x35 0x4f 0x74 0x68 0x65 0x72 0x00
